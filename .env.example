# Copy this file to ".env" and fill in your values. Never share or commit .env.

# Alpaca API keys (paper account: alpaca.markets -> Paper -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper (fake money). Only set to false when you deliberately go live.
ALPACA_PAPER=true

# The SEC requires a contact email in every request. Use your own email.
SEC_USER_AGENT=claude-training-bot your.email@example.com

# Daily report email (Gmail + app password from myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_TO=
